# ══════════════════════════════════════════════════════════════
# HAKIKU — Environment Variables
# ══════════════════════════════════════════════════════════════
#
# Cara setup:
# 1. Copy file ini → .env.local
# 2. Isi nilai yang diperlukan
# 3. JANGAN commit .env.local ke GitHub!
#
# ══════════════════════════════════════════════════════════════

# ── GEMINI AI ─────────────────────────────────────────────────
# Dapatkan API key GRATIS di: https://aistudio.google.com/app/apikey
# Variabel ini HANYA dipakai di server (API routes) — aman dari browser
GEMINI_API_KEY=your_gemini_api_key_here

# ── GEMINI MODEL ──────────────────────────────────────────────
# Model yang digunakan untuk chat dan review dokumen
GEMINI_MODEL=gemini-2.0-flash

# ── APP CONFIG ────────────────────────────────────────────────
# URL aplikasi (untuk production, ganti dengan domain kamu)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nama aplikasi (tampil di beberapa tempat di UI)
NEXT_PUBLIC_APP_NAME=HAKIKU

# ── Auth ─────────────────────────────────────────────────────
# Username dan password untuk login ke platform HAKIKU
HAKIKU_USERNAME=admin
HAKIKU_PASSWORD=hakiku2026
